# SPDX-License-Identifier: LGPL-3.0-or-later
pkgname=megu-bin
pkgver=0.1.0_alpha.3
pkgrel=1
pkgdesc='A Minecraft-compatible engine written in Rust'
arch=('x86_64' 'aarch64')
url='https://github.com/nekomario28/megu-mc'
license=('LGPL-3.0-or-later')
provides=('megu')
conflicts=('megu')
_tag="v${pkgver/_/-}"
source_x86_64=("https://github.com/nekomario28/megu-mc/releases/download/${_tag}/megu-${_tag}-linux-x86_64.tar.gz")
source_aarch64=("https://github.com/nekomario28/megu-mc/releases/download/${_tag}/megu-${_tag}-linux-arm64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  local target archive expected actual
  case "$CARCH" in
    x86_64) target=linux-x86_64 ;;
    aarch64) target=linux-arm64 ;;
    *) error "Unsupported architecture: $CARCH"; return 1 ;;
  esac
  archive="${srcdir}/megu-${_tag}-${target}.tar.gz"
  curl --fail --location --silent --show-error \
    "https://github.com/nekomario28/megu-mc/releases/download/${_tag}/SHA256SUMS-all.txt" \
    -o "${srcdir}/SHA256SUMS-all.txt"
  expected=$(awk -v file="$(basename "$archive")" '$2 == file { print $1; count++ } END { if (count != 1) exit 1 }' "${srcdir}/SHA256SUMS-all.txt")
  actual=$(sha256sum "$archive" | cut -d' ' -f1)
  [[ "$expected" =~ ^[0-9a-f]{64}$ && "$actual" == "$expected" ]] || {
    error 'Release archive SHA-256 mismatch'; return 1;
  }
  install -d "${pkgdir}/usr/bin" "${pkgdir}/usr/share/licenses/${pkgname}"
  tar -xzf "$archive" -C "${srcdir}"
  local bundle="${srcdir}/megu-${_tag}-${target}"
  local bin
  for bin in megu megu-client-gpu megu-installer; do
    [[ -f "${bundle}/${bin}" ]] && install -m755 "${bundle}/${bin}" "${pkgdir}/usr/bin/${bin}"
  done
  install -m644 "${bundle}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
