#[ignore = "explicit release-profile run from the isolated tick profiler"]
fn profile_game_tick() {
    let scratch = std::env::var("MC_SPINE_TICK_PROFILE_DIR").expect("use the isolated profiling runner");
    assert_eq!(std::env::current_dir().unwrap(), std::path::PathBuf::from(scratch));
    assert_ne!(std::env::current_dir().unwrap(), std::path::PathBuf::from(env!("CARGO_MANIFEST_DIR")));
    assert!(!worldgen::enabled(), "this fixture measures the flat/headless tick only");
    for (scenario, actor, machines, active) in [
        ("empty", false, 0, false),
        ("idle_actor", true, 0, false),
        ("idle_furnaces", true, 400, false),
        ("active_furnaces", true, 400, true),
    ] {
        actors().lock().unwrap().clear();
        furnaces().lock().unwrap().clear();
        forceloaded().lock().unwrap().clear();
        TICK.store(1, Ordering::Relaxed);
        TICK_IDX.store(0, Ordering::Relaxed);
        WORLD_TIME.store(1000, Ordering::Relaxed);
        if actor {
            actors().lock().unwrap().insert("tick-profile".into(), Arc::new(Actor {
                name: "tick-profile".into(), eid: 4242, pos: Mutex::new((0.0, 70.0, 0.0)),
                look: Mutex::new(None), action: Mutex::new(""), held: Mutex::new((0, 0, Vec::new())),
                inv: Mutex::new(HashMap::new()),
            }));
        }
        for i in 0..machines {
            furnaces().lock().unwrap().insert((i % 16, 70 + i / 256, (i / 16) % 16), furnace(if active { 64 } else { 0 }));
        }
        for _ in 0..100 { game_tick(|_, tick| tick()); }
        let mut totals: std::collections::BTreeMap<&str, (u128, u128, usize)> = std::collections::BTreeMap::new();
        let mut samples = Vec::with_capacity(1000);
        for _ in 0..1000 {
            let start = Instant::now();
            game_tick(|name, tick| {
                let begin = Instant::now();
                tick();
                let elapsed = begin.elapsed().as_nanos();
                let item = totals.entry(name).or_default();
                item.0 += elapsed; item.1 = item.1.max(elapsed); item.2 += 1;
            });
            samples.push(start.elapsed().as_nanos());
        }
        if machines > 0 {
            let fs = furnaces().lock().unwrap();
            for f in fs.values() {
                assert_eq!((f.output.1, f.progress, f.burn_left, f.fuel.1),
                    if active { (27, 20, 180, 60) } else { (0, 0, 0, 64) });
            }
        }
        samples.sort_unstable();
        println!("PROFILE\t{scenario}\ttick\t{}\t{}\t{}\t{}\t{}",
            samples.len(), samples.iter().sum::<u128>(), samples[499], samples[949], samples[989]);
        for (stage, (total, max, calls)) in totals {
            println!("PROFILE\t{scenario}\t{stage}\t{calls}\t{total}\t{max}");
        }
    }
}
#!/usr/bin/env python3
"""Measure the production tick fixture, without starting listeners or touching a user world."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import signal
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[2]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--runs", type=int, default=3)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    if not 1 <= args.runs <= 10:
        parser.error("runs must be between 1 and 10")
    output = args.output.resolve()
    output.mkdir(parents=True, exist_ok=True)
    command = ["cargo", "test", "--release", "--offline", "--locked", "-j", "2", "--no-run", "--message-format=json"]
    build = subprocess.run(command, cwd=ROOT, capture_output=True, text=True, timeout=240)
    (output / "build.log").write_text(build.stderr)
    if build.returncode:
        raise RuntimeError(f"release test build failed; see {output / 'build.log'}")
    artifacts = [json.loads(line) for line in build.stdout.splitlines() if line.startswith("{")]
    binary = next(Path(item["executable"]) for item in artifacts
                  if item.get("reason") == "compiler-artifact" and item.get("executable")
                  and item["target"]["name"] == "mc-spine")
    results = []
    for index in range(args.runs):
        log = output / f"run-{index}.log"
        with tempfile.TemporaryDirectory(prefix="mc-spine-tick-profile-") as scratch:
            pid = os.fork()
            if pid == 0:
                try:
                    os.chdir(scratch)
                    env = dict(os.environ, MC_SPINE_TICK_PROFILE_DIR=scratch)
                    with log.open("wb") as stream:
                        os.dup2(stream.fileno(), 1)
                        os.dup2(stream.fileno(), 2)
                        signal.alarm(120)
                        os.execve(binary, [str(binary), "tick_tests::profile_game_tick", "--exact", "--ignored", "--nocapture", "--test-threads=1"], env)
                except BaseException:
                    os._exit(127)
            _, status, usage = os.wait4(pid, 0)
            if os.waitstatus_to_exitcode(status) != 0:
                raise RuntimeError(f"profile child failed (status {status}); see {log}")
        scenarios = {}
        for line in log.read_text().splitlines():
            marker = line.find("PROFILE\t")
            if marker < 0:
                continue
            _, scenario, stage, *values = line[marker:].split("\t")
            values = list(map(int, values))
            item = scenarios.setdefault(scenario, {})
            if stage == "tick":
                item["tick"] = dict(zip(("samples", "total_ns", "p50_ns", "p95_ns", "p99_ns"), values))
            else:
                item.setdefault("stages", {})[stage] = dict(zip(("calls", "total_ns", "max_ns"), values))
        assert set(scenarios) == {"empty", "idle_actor", "idle_furnaces", "active_furnaces"}
        for item in scenarios.values():
            assert item["tick"]["samples"] == 1000
            assert len(item["stages"]) == 15
            assert all(value["calls"] == (167 if name == "lava" else 1000)
                       for name, value in item["stages"].items())
        results.append({"run": index, "cpu_user_seconds": usage.ru_utime,
                        "cpu_system_seconds": usage.ru_stime, "peak_rss_kib": usage.ru_maxrss,
                        "scenarios": scenarios})
    source = [str(path.relative_to(ROOT)) for path in sorted((ROOT / "src").glob("*.rs"))]
    source += ["Cargo.toml", "Cargo.lock", "evidence/time-contract/profile_tick.py"]
    report = {
        "revision": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
        "working_diff_sha256": hashlib.sha256(subprocess.check_output(["git", "diff", "HEAD"], cwd=ROOT)).hexdigest(),
        "source_sha256": {name: hashlib.sha256((ROOT / name).read_bytes()).hexdigest() for name in source},
        "binary_sha256": hashlib.sha256(binary.read_bytes()).hexdigest(),
        "rustc": subprocess.check_output(["rustc", "--version"], text=True).strip(),
        "build_command": command, "clock": "unchanged 4TPS semantics; executed without sleep",
        "scope": "flat headless fixture; 100 warmup + 1000 measured ticks per scenario; no clients, mobs, fluids, worldgen, Java mods",
        "cpu_rss_scope": "whole child: all four scenarios, fixture setup, warmup and output; Linux RSS in KiB",
        "results": results,
    }
    (output / "results.json").write_text(json.dumps(report, indent=2) + "\n")
    print(json.dumps(report, indent=2))


if __name__ == "__main__":
    main()
# 03 — 切替前の本番tick計測

## 契約

本番tickの順序と呼出し条件を一つのgame_tickで所有し、mainのthreadと計測が
同じ関数を呼ぶ。既存の250ms周期・時間語・処理順・lavaの6回に1回という条件は維持。
新しいschedulerや設定、通常tickの時間計測は追加しない。
実行callbackは本番では即実行、計測では同じstageを時間計測して実行する。

## ゲート

温かい炉が同じtickで進行し、coldの炉は変わらず、両時計が1更新ずつ進むことを
production game_tick経路で検証する。炉stageを欠落させる負の対照で失敗を確認する。
既存全テストを維持。mainの元のstage順序・lava条件をdiffで確認する。

## 計測

明示実行するignoredテストで、空世界、idle Actorによるhot/warm ring、休止炉、
稼働炉を測る。ウォームアップ後のtick wall time分位とstage総時間/呼出し回数を出力。
最適化ビルドを使い、別々のプロセスで繰り返す。fixtureのCPU/RSSは外側で取得する。

ignoredテストは専用の一時working directoryから実行する。通常cargo testに混ぜない。
本番のautosaveも実行するため、WORLD_FILEをユーザーのworking directoryへ書かせない。
既存世界を読込まない、listenerを開かない、終わったら一時dirとプロセスを残さない。
全stageを測るが、fixtureにはプレイヤー・Mob・液体・Java Mod・worldgenを含めない。
Actorはhot/warm更新の負荷を作るだけで、プレイヤーの代理とは呼ばない。
この数値をサーバー全体の性能や20TPS後の結果として主張しない。

## 委譲と次の判断

fixture規模・反復回数・出力形式は実装者が選んで記録する。恒常的な新依存を増やさない。
費用の順位から次の小さな最適化を選ぶ。動作契約が未確定なまま20TPSを有効化しない。

