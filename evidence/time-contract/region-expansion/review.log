                    }}
                    format!("Marked chunk for forceload ({} chunks)", n)
                }
                "query" => format!("{} forceloaded chunk(s)", forceloaded().lock().unwrap().len()),
                _ => "usage: /forceload add|remove x z [x2 z2] | query".into(),
            }
    }
