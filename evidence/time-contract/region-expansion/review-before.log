            let _ = c.surface(0, 0);
        }}
        eprintln!("[wgprof] {}x{} chunks in {:?} ({:.1} ms/chunk)", n, n, t0.elapsed(), t0.elapsed().as_secs_f64()*1000.0/(n*n) as f64);
