                    for i in 0..46i16 {
                        let (it2, c2, _cc) = inv.get(&i).cloned().unwrap_or((0, 0, Vec::new()));
                        q.extend_from_slice(&slot_wire(&(it2, c2, _cc)));
                    }
                    q.extend_from_slice(&slot_wire(&(0, 0, Vec::new())));
                    if let Ok(mut w) = c.sock.lock() { let _ = send_packet(&mut *w, 0x13, q); }
                }
            }
            format!("Cleared {} item(s)", removed)
        }
        "effect" => {
            // /effect give <target> <effect> [seconds] [amplifier]
            // /effect clear <target> [effect]
            let sub = args.first().copied().unwrap_or("");
            let sel = args.get(1).copied().unwrap_or("@s");
            let targets = if sel.starts_with('@') { resolve_selector(sel, me) }
                else { clients().lock().unwrap().iter().find(|c| c.name == sel)
                    .map(|c| vec![c.eid.to_string()]).unwrap_or_default() };
            // hold a snapshot of client Arcs, not the clients() mutex —
            // broadcast_seen re-locks clients() internally.
            let cls_snap: Vec<Arc<Client>> = { clients().lock().unwrap().iter().cloned().collect() };
            let mut touched = 0;
            let mut fx: Vec<(Arc<Client>, Vec<u8>)> = Vec::new(); // (target, entity_effect pkt)
            let mut rx: Vec<(Arc<Client>, Vec<u8>)> = Vec::new(); // (target, remove_effect pkt)
            let reply2 = match sub {
                "give" => {
                    let ename = args.get(2).copied().unwrap_or("");
                    let Some(eid2) = name_to_effect(ename) else {
                        return format!("unknown effect '{ename}'")
                    };
                    let secs = args.get(3).and_then(|a| a.parse::<i32>().ok()).unwrap_or(30);
                    let amp = args.get(4).and_then(|a| a.parse::<i32>().ok()).unwrap_or(0);
                    for t in &targets {
                        if let Some(c) = cls_snap.iter().find(|c| c.eid.to_string() == *t) {
                            match eid2 {
                                // instant effects apply once, not stored
                                5 => { let mut h = c.hp.lock().unwrap();
                                    *h = (*h + 4.0 * (amp + 1) as f32).min(20.0);
                                    if let Ok(mut w) = c.sock.lock() { let _ = send_packet(&mut *w, 0x5d, health_pkt_c(*h, c)); } }
                                6 => { let mut h = c.hp.lock().unwrap();
                                    *h = (*h - 6.0 * (amp + 1) as f32).max(0.0);
                                    if *h <= 0.0 { drop(h); totem_check(c); h = c.hp.lock().unwrap(); }
                                    if let Ok(mut w) = c.sock.lock() { let _ = send_packet(&mut *w, 0x5d, health_pkt_c(*h, c)); } }
                                22 => { let mut f = c.food.lock().unwrap();
                                    *f = (*f + amp + 1).min(20); drop(f);
                                    if let Ok(mut w) = c.sock.lock() { let _ = send_packet(&mut *w, 0x5d, health_pkt_c(*c.hp.lock().unwrap(), c)); } }
                                _ => {
                                    let ticks = secs * TICKS_PER_SECOND as i32; // server ticks
                                    { let mut ef = c.effs.lock().unwrap();
                                      ef.retain(|e| e.id != eid2);
                                      ef.push(Eff { id: eid2, amp, left: ticks }); }
                                    fx.push(((*c).clone(), entity_effect_pkt(c.eid, eid2, amp, ticks * GAME_TICKS_PER_TICK as i32)));
                                }
                            }
                            touched += 1;
                        }
                    }
                    format!("Applied effect to {} target(s)", touched)
                }
                "clear" => {
                    let ename = args.get(2).copied().unwrap_or("");
                    let want: Option<i32> = if ename.is_empty() { None } else { name_to_effect(ename) };
                    for t in &targets {
                        if let Some(c) = cls_snap.iter().find(|c| c.eid.to_string() == *t) {
                            let gone: Vec<i32> = { let mut ef = c.effs.lock().unwrap();
                                let g: Vec<i32> = ef.iter().filter(|e| want.map(|w| w == e.id).unwrap_or(true)).map(|e| e.id).collect();
                                ef.retain(|e| want.map(|w| w != e.id).unwrap_or(false)); g };
use super::*;

fn furnace(input_count: u8) -> Furnace {
    Furnace {
        input: (name_to_item("raw_iron").unwrap(), input_count, Vec::new()),
        fuel: (name_to_item("coal").unwrap(), 64, Vec::new()),
        output: (0, 0, Vec::new()), burn_left: 0, progress: 0, dirty: false, xp: 0.0,
        recipe_cache: CachedLookup::default(), fuel_cache: CachedLookup::default(),
    }
}

#[test]
fn game_tick_progresses_warm_furnace_and_keeps_cold_furnace_unchanged() {
    let _world_guard = WORLD_TEST_LOCK.lock().unwrap();
    let old_furnaces = std::mem::take(&mut *furnaces().lock().unwrap());
    let old_forced = std::mem::take(&mut *forceloaded().lock().unwrap());
    let old_hot = hot().lock().unwrap().clone();
    let old_warm = warm().lock().unwrap().clone();
    let old_tick = TICK.swap(1, Ordering::Relaxed);
    let old_index = TICK_IDX.swap(0, Ordering::Relaxed);
    let old_time = WORLD_TIME.swap(1000, Ordering::Relaxed);
    let old_daylight = GR_DAYLIGHT_CYCLE.swap(1, Ordering::Relaxed);
    forceloaded().lock().unwrap().insert((0, 0));
    let warm_pos = (0, 70, 0);
    let cold_pos = (1600, 70, 1600);
    furnaces().lock().unwrap().insert(warm_pos, furnace(2));
    furnaces().lock().unwrap().insert(cold_pos, furnace(2));
    game_tick(|_, tick| tick());
    let actual = {
        let fs = furnaces().lock().unwrap();
        let hot = &fs[&warm_pos];
        let cold = &fs[&cold_pos];
        (hot.progress, hot.burn_left, hot.fuel.1, cold.progress, cold.burn_left, cold.fuel.1)
    };
    let clocks = (TICK.load(Ordering::Relaxed), TICK_IDX.load(Ordering::Relaxed), WORLD_TIME.load(Ordering::Relaxed));
    *furnaces().lock().unwrap() = old_furnaces;
    *forceloaded().lock().unwrap() = old_forced;
    *hot().lock().unwrap() = old_hot;
    *warm().lock().unwrap() = old_warm;
    TICK.store(old_tick, Ordering::Relaxed);
    TICK_IDX.store(old_index, Ordering::Relaxed);
    WORLD_TIME.store(old_time, Ordering::Relaxed);
    GR_DAYLIGHT_CYCLE.store(old_daylight, Ordering::Relaxed);
    // These are the current 4TPS contract, NOT vanilla 20TPS acceptance values.
    assert_eq!(actual, (1, 319, 63, 0, 0, 64));
    assert_eq!(clocks, (2, 1, 1005));
}

#[test]
fn region_membership_matches_hot_plus_skirt_across_input_changes() {
    let _world_guard = WORLD_TEST_LOCK.lock().unwrap();
    assert!(clients().lock().unwrap().is_empty());
    let old_actors = std::mem::take(&mut *actors().lock().unwrap());
    let old_forced = std::mem::take(&mut *forceloaded().lock().unwrap());
    let old_hot = hot().lock().unwrap().clone();
    let old_warm = warm().lock().unwrap().clone();
    let mut observations = Vec::new();
    refresh_hot();
    observations.push((hot().lock().unwrap().clone(), warm().lock().unwrap().clone(), HashSet::new(), HashSet::new()));
    for name in ["moving", "stationary"] {
        actors().lock().unwrap().insert(name.into(), Arc::new(Actor {
            name: name.into(), eid: 4242, pos: Mutex::new((0.0, 70.0, 0.0)),
            look: Mutex::new(None), action: Mutex::new(""), held: Mutex::new((0, 0, Vec::new())),
            inv: Mutex::new(HashMap::new()),
        }));
    }
    for (i, (x, z, cx, cz)) in [
        (0.0, 0.0, 0, 0), (15.999, 15.999, 0, 0), (16.0, 16.0, 1, 1),
        (-0.01, -0.01, -1, -1), (-16.0, -16.0, -1, -1), (-16.01, -16.01, -2, -2),
        (160.0, -160.0, 10, -10), (30_000_000.0, -30_000_000.0, 1_875_000, -1_875_000),
    ].into_iter().enumerate() {
        *actors().lock().unwrap()["moving"].pos.lock().unwrap() = (x, 70.0, z);
        forceloaded().lock().unwrap().clear();
        let mut expected_hot = HashSet::new();
        if i % 2 == 0 {
            forceloaded().lock().unwrap().insert((200, -200));
            expected_hot.insert((200, -200));
        }
        for (px, pz) in [(cx, cz), (0, 0)] {
            for dx in -5..=5 { for dz in -5..=5 { expected_hot.insert((px + dx, pz + dz)); } }
        }
        // Independent oracle: the original hot-then-skirt algorithm.
        let mut expected_warm = expected_hot.clone();
        for &(px, pz) in &expected_hot {
            for dx in -3..=3 { for dz in -3..=3 { expected_warm.insert((px + dx, pz + dz)); } }
        }
        refresh_hot();
        observations.push((hot().lock().unwrap().clone(), warm().lock().unwrap().clone(), expected_hot, expected_warm));
    }
    actors().lock().unwrap().clear();
    for x in 0..10 { for z in 0..10 {
        let name = format!("dense-{x}-{z}");
        actors().lock().unwrap().insert(name.clone(), Arc::new(Actor {
            name, eid: 4242, pos: Mutex::new((16.0 * x as f64, 70.0, 16.0 * z as f64)),
            look: Mutex::new(None), action: Mutex::new(""), held: Mutex::new((0, 0, Vec::new())),
            inv: Mutex::new(HashMap::new()),
        }));
    } }
    refresh_hot();
    let expected_hot = (-5..=14).flat_map(|x| (-5..=14).map(move |z| (x, z))).collect();
    let expected_warm = (-8..=17).flat_map(|x| (-8..=17).map(move |z| (x, z))).collect();
    observations.push((hot().lock().unwrap().clone(), warm().lock().unwrap().clone(), expected_hot, expected_warm));
    actors().lock().unwrap().clear();
    forceloaded().lock().unwrap().insert((-12, 9));
    refresh_hot();
    let expected_hot = HashSet::from([(-12, 9)]);
    let mut expected_warm = HashSet::new();
    for dx in -3..=3 { for dz in -3..=3 { expected_warm.insert((-12 + dx, 9 + dz)); } }
    observations.push((hot().lock().unwrap().clone(), warm().lock().unwrap().clone(), expected_hot, expected_warm));
    forceloaded().lock().unwrap().clear();
    refresh_hot();
    observations.push((hot().lock().unwrap().clone(), warm().lock().unwrap().clone(), HashSet::new(), HashSet::new()));
    *actors().lock().unwrap() = old_actors;
    *forceloaded().lock().unwrap() = old_forced;
    *hot().lock().unwrap() = old_hot;
    *warm().lock().unwrap() = old_warm;
    for (actual_hot, actual_warm, expected_hot, expected_warm) in observations {
        assert_eq!(actual_hot, expected_hot);
        assert_eq!(actual_warm, expected_warm);
    }
}

#[test]
fn cadence_owner_keeps_world_clock_at_vanilla_rate() {
    let _world_guard = WORLD_TEST_LOCK.lock().unwrap();
    // 20 game ticks per real second is the invariant the world clock must keep.
    // A cadence change is only coherent if this product stays 20.
    assert_eq!(TICKS_PER_SECOND * GAME_TICKS_PER_TICK, 20);
    assert_eq!(TICKS_PER_SECOND as u64 * TICK_MS, 1000);
    let old_time = WORLD_TIME.swap(1000, Ordering::Relaxed);
    let old_tick = TICK.swap(1, Ordering::Relaxed);
    let old_index = TICK_IDX.swap(0, Ordering::Relaxed);
    let old_actors = std::mem::take(&mut *actors().lock().unwrap());
    let old_forced = std::mem::take(&mut *forceloaded().lock().unwrap());
    let old_hot = hot().lock().unwrap().clone();
    let old_warm = warm().lock().unwrap().clone();
    let advanced = {
        game_tick(|_, tick| tick());
        WORLD_TIME.load(Ordering::Relaxed) - 1000
    };
    *actors().lock().unwrap() = old_actors;
    *forceloaded().lock().unwrap() = old_forced;
    *hot().lock().unwrap() = old_hot;
    *warm().lock().unwrap() = old_warm;
    TICK.store(old_tick, Ordering::Relaxed);
    TICK_IDX.store(old_index, Ordering::Relaxed);
    WORLD_TIME.store(old_time, Ordering::Relaxed);
    assert_eq!(advanced, GAME_TICKS_PER_TICK as u64);
}

#[test]
#[ignore = "explicit release-profile run from the isolated tick profiler"]
fn profile_game_tick() {
    let _world_guard = WORLD_TEST_LOCK.lock().unwrap();
    let scratch = std::env::var("MC_SPINE_TICK_PROFILE_DIR").expect("use the isolated profiling runner");
    assert_eq!(std::env::current_dir().unwrap(), std::path::PathBuf::from(scratch));
    assert_ne!(std::env::current_dir().unwrap(), std::path::PathBuf::from(env!("CARGO_MANIFEST_DIR")));
    assert!(!worldgen::enabled(), "this fixture measures the flat/headless tick only");
    for (scenario, actor_count, machines, active) in [
        ("empty", 0, 0, false),
        ("idle_actor", 1, 0, false),
        ("idle_furnaces", 1, 400, false),
        ("active_furnaces", 1, 400, true),
        ("crowded_actors", 100, 0, false),
        ("dense_actors", 100, 0, false),
    ] {
        actors().lock().unwrap().clear();
        furnaces().lock().unwrap().clear();
        forceloaded().lock().unwrap().clear();
        TICK.store(1, Ordering::Relaxed);
        TICK_IDX.store(0, Ordering::Relaxed);
        WORLD_TIME.store(1000, Ordering::Relaxed);
        for i in 0..actor_count {
            let name = format!("tick-profile-{i}");
            let pos = if scenario == "dense_actors" { (16.0 * (i % 10) as f64, 70.0, 16.0 * (i / 10) as f64) } else { (0.0, 70.0, 0.0) };
            actors().lock().unwrap().insert(name.clone(), Arc::new(Actor {
                name, eid: 4242 + i, pos: Mutex::new(pos),
                look: Mutex::new(None), action: Mutex::new(""), held: Mutex::new((0, 0, Vec::new())),
                inv: Mutex::new(HashMap::new()),
            }));
        }
        for i in 0..machines {
            furnaces().lock().unwrap().insert((i % 16, 70 + i / 256, (i / 16) % 16), furnace(if active { 64 } else { 0 }));
        }
        for _ in 0..100 { game_tick(|_, tick| tick()); }
        let mut totals: std::collections::BTreeMap<&str, (u128, u128, usize)> = std::collections::BTreeMap::new();
        let mut samples = Vec::with_capacity(1000);
        for _ in 0..1000 {
            let start = Instant::now();
            game_tick(|name, tick| {
                let begin = Instant::now();
                tick();
                let elapsed = begin.elapsed().as_nanos();
                let item = totals.entry(name).or_default();
                item.0 += elapsed; item.1 = item.1.max(elapsed); item.2 += 1;
            });
            samples.push(start.elapsed().as_nanos());
        }
        if machines > 0 {
            let fs = furnaces().lock().unwrap();
            for f in fs.values() {
                assert_eq!((f.output.1, f.progress, f.burn_left, f.fuel.1),
                    if active { (27, 20, 180, 60) } else { (0, 0, 0, 64) });
            }
        }
        samples.sort_unstable();
        println!("PROFILE\t{scenario}\ttick\t{}\t{}\t{}\t{}\t{}",
            samples.len(), samples.iter().sum::<u128>(), samples[499], samples[949], samples[989]);
        for (stage, (total, max, calls)) in totals {
            println!("PROFILE\t{scenario}\t{stage}\t{calls}\t{total}\t{max}");
        }
    }
}
use super::*;

fn client_pair() -> (Client, TcpStream) {
    let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
    let receiver = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
    receiver.set_read_timeout(Some(Duration::from_secs(1))).unwrap();
    let (sender, _) = listener.accept().unwrap();
    let past = Instant::now() - Duration::from_secs(10);
    let client = Client {
        eid: 4242, uuid: [0; 16], name: "totem-test".into(),
        pos: Mutex::new((0.0, 70.0, 0.0, 0.0, 0.0, true)), hp: Mutex::new(20.0),
        sock: Mutex::new(sender), inv: Mutex::new(HashMap::new()),
        cursor: Mutex::new((0, 0, Vec::new())), drag: Mutex::new((-1, Vec::new())),
        open_chest: Mutex::new(None), open_furnace: Mutex::new(None),
        craft: Mutex::new(HashMap::new()), craft9: Mutex::new(HashMap::new()),
        open_table: Mutex::new(false), open_merchant: Mutex::new(false), trade_sel: Mutex::new(-1),
        merchant_in: Mutex::new([(0, 0, Vec::new()), (0, 0, Vec::new())]),
        bow_draw: Mutex::new(None), dig: Mutex::new(None), eat_start: Mutex::new(None),
        blocking: Mutex::new(false), sprinting: Mutex::new(false), sneaking: Mutex::new(false),
        last_melee: Mutex::new(past), fall_fly: Mutex::new(false), hurt_at: Mutex::new(past),
        shield_cd: Mutex::new(past), absorb: Mutex::new(0.0), pearl_cd: Mutex::new(past),
        xp: Mutex::new(0), skin: Mutex::new(None), seen: Mutex::new(HashSet::new()),
        chunks: Mutex::new(HashSet::new()), gm: Mutex::new(0), fall_from: Mutex::new(70.0),
        food: Mutex::new(20), air: Mutex::new(60), armor_pts: Mutex::new(0), sat: Mutex::new(5.0),
        walk_acc: Mutex::new(0.0), lastp: Mutex::new((0.0, 70.0, 0.0)),
        spawn_pt: Mutex::new(None), held: Mutex::new(0), effs: Mutex::new(Vec::new()),
    };
    (client, receiver)
}

#[test]
fn death_protection_updates_state_and_sends_effect_changes() {
    let (client, mut receiver) = client_pair();
    let totem = name_to_item("totem_of_undying").unwrap();
    client.inv.lock().unwrap().insert(45, (totem, 2, Vec::new()));
    *client.hp.lock().unwrap() = 0.0;
    client.effs.lock().unwrap().push(Eff { id: 18, amp: 1, left: 80 });
    totem_check(&client);
    assert_eq!(*client.hp.lock().unwrap(), 1.0);
    assert_eq!(client.inv.lock().unwrap().get(&45), Some(&(totem, 1, Vec::new())));
    assert_eq!(*client.absorb.lock().unwrap(), 8.0);
    assert_eq!(hurt_absorb(&client, 3.0), 0.0);
    assert_eq!(*client.absorb.lock().unwrap(), 5.0);
    assert_eq!(hurt_absorb(&client, 7.0), 2.0);
    assert_eq!(*client.absorb.lock().unwrap(), 0.0);

    client.sock.lock().unwrap().shutdown(std::net::Shutdown::Write).unwrap();
    let mut changes = Vec::new();
    while let Some((packet, body)) = read_packet(&mut receiver) {
        if packet == 0x43 || packet == 0x76 {
            let mut payload = &body[..];
            let entity = read_varint(&mut payload).unwrap();
            let effect = read_varint(&mut payload).unwrap();
            if packet == 0x43 {
                assert!(payload.is_empty());
                changes.push((packet, entity, effect, None));
            } else {
                let amplifier = read_varint(&mut payload).unwrap();
                let duration = read_varint(&mut payload).unwrap();
                assert_eq!(payload, &[0x06]);
                changes.push((packet, entity, effect, Some((amplifier, duration))));
            }
        }
    }
    assert_eq!(changes, vec![
        (0x43, 4242, 18, None),
        (0x76, 4242, 9, Some((1, 900))),
        (0x76, 4242, 21, Some((1, 100))),
        (0x76, 4242, 11, Some((0, 800))),
    ]);
}

#[test]
fn totem_replaces_existing_effects_with_vanilla_grant() {
    let mut effects = vec![
        Eff { id: 18, amp: 2, left: 120 }, // poison must not survive death protection
        Eff { id: 9, amp: 4, left: 1 },
        Eff { id: 21, amp: 0, left: 40 },
        Eff { id: 21, amp: 0, left: 40 },
    ];
    // The production clock is still 4TPS. Compare its stored durations in
    // vanilla game ticks; remove this conversion during the atomic 20TPS cutover.
    let snapshot = |effects: &[Eff]| {
        let mut result: Vec<_> = effects.iter().map(|e| (e.id, e.amp, e.left * GAME_TICKS_PER_TICK as i32)).collect();
        result.sort_unstable();
        result
    };
    let expected = vec![(9, 1, 900), (11, 0, 800), (21, 1, 100)];
    totem_effects(&mut effects);
    assert_eq!(snapshot(&effects), expected);
    totem_effects(&mut effects);
    assert_eq!(snapshot(&effects), expected, "repeated grants must not duplicate effects");
}

#[test]
fn wither_death_protection_stops_old_effects_and_keeps_new_grants() {
    let (client, _receiver) = client_pair();
    client.inv.lock().unwrap().insert(45, (name_to_item("totem_of_undying").unwrap(), 1, Vec::new()));
    *client.hp.lock().unwrap() = 1.0;
    *client.effs.lock().unwrap() = vec![
        Eff { id: 21, amp: 0, left: 1 }, // expires in the old set
        Eff { id: 19, amp: 0, left: 1 }, // lethal wither
        Eff { id: 16, amp: 0, left: 81 }, // must not run after death protection removes it
    ];
    effects::tick_effects(&client);
    assert_eq!(*client.hp.lock().unwrap(), 1.0);
    assert!(!client.inv.lock().unwrap().contains_key(&45));
    assert_eq!(*client.food.lock().unwrap(), 20);
    assert_eq!(*client.absorb.lock().unwrap(), 8.0);
    let mut actual: Vec<_> = client.effs.lock().unwrap().iter().map(|e| (e.id, e.amp, e.left)).collect();
    actual.sort_unstable();
    assert_eq!(actual, vec![(9, 1, 180), (11, 0, 160), (21, 1, 20)]);
}

#[test]
fn absorption_expiry_removes_unspent_shield() {
    let (client, _receiver) = client_pair();
    *client.absorb.lock().unwrap() = 8.0;
    client.effs.lock().unwrap().push(Eff { id: 21, amp: 1, left: 2 });
    effects::tick_effects(&client);
    assert_eq!(*client.absorb.lock().unwrap(), 8.0, "still active before expiry");
    effects::tick_effects(&client);
    assert!(client.effs.lock().unwrap().is_empty());
    assert_eq!(hurt_absorb(&client, 3.0), 3.0, "expired absorption must not intercept damage");
    assert_eq!(*client.absorb.lock().unwrap(), 0.0);
}
