# ---- build outputs -------------------------------------------------------------------------
/target/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.venv/
venv/
*.profraw
perf.data
perf.data.*
flamegraph*.svg

# ---- logs and scratch ----------------------------------------------------------------------
*.log
# Curated, receipt-pinned run logs are tracked on purpose (the rule above would otherwise hide them
# and `git ls-files -ci` would list them). New ones elsewhere under evidence/ need `git add -f`.
!/evidence/*.log
!/evidence/time-contract/**/*.log
logs/
*.tmp
*.bak
*.orig
*.rej
/scratch/
/evidence/**/scratch/
/evidence/**/tmp/

# ---- local world / saves written by the server ---------------------------------------------
# The server writes ./world_overlay.bin (+ .tmp while writing and .bak, the retained previous save),
# and a fixture that runs a second overlay writes world_overlay_<name>.bin. Both spellings are
# local state: the file is regenerable from the seed and must never be committed.
/world_overlay*.bin
# The settings file the server writes on first boot (`src/server_config.rs`) is local too.
/server.toml
/world_overlay*.bin.*
/world/
/saves/
*.mca

# ---- JVM side: downloaded jars, build trees, mappings (never committed or redistributed) ----
# compat/*/build.py download NeoForge / Fabric Loader / Mixin / ASM / the pinned mod into .cache/
# (URL + sha256 pinned in dependencies.json) and compile our own classes into .build/.
*.jar
*.class
/mods/
/compat/fabric-probe/.cache/
/compat/fabric-probe/.build/
/compat/neoforge-events/.cache/
/compat/neoforge-events/.build/
# Mojang/Fabric name mappings and decompiler output are inputs, not sources
*.tiny
/server.txt
mappings*.txt
*.mapping.txt
*.javap.txt
# a vanilla server dropped into the repo root
/server.jar
/libraries/
/versions/
/eula.txt

# ---- game data ----------------------------------------------------------------------------
# This branch keeps its data in-tree (datapacks/vanilla, config_packets.bin, assets/*.json and the
# tests/data fixtures are tracked on purpose: the suite reads them, and the fixtures are this
# project's own measurements). `tools/vanilla_data/gen_vanilla_data.sh` regenerates them from your
# own pinned 1.21.1 jar and `--verify` checks the tree without one; its output is *not* ignored
# here.
# The three files that were tracked without a usable provenance are gone - assets/pblocks.json and
# assets/properties.json (byte-identical to another project's GPL-3.0 data) and resourcepack.zip
# (origin unknown, optional server feature) - and `tools/provenance_check.py` fails the build if one
# comes back into the index or into src/. A resource pack you supply yourself for a local run is
# still only a user input: this tree ships none, so nothing here is hidden from `git status`
# except that local copy.
/resourcepack.zip
# `gen_vanilla_data.sh` builds the datapack in this sibling directory and swaps it in whole.
/datapacks/vanilla.stage/

