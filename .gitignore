# ---- build outputs -------------------------------------------------------------------------
/target/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.venv/
venv/
*.profraw
perf.data
perf.data.*
flamegraph*.svg

# ---- logs and scratch ----------------------------------------------------------------------
*.log
# Curated, receipt-pinned run logs are tracked on purpose (the rule above would otherwise hide them
# and `git ls-files -ci` would list them). New ones elsewhere under evidence/ need `git add -f`.
!/evidence/*.log
!/evidence/time-contract/**/*.log
logs/
*.tmp
*.bak
*.orig
*.rej
/scratch/
/evidence/**/scratch/
/evidence/**/tmp/

# ---- local world / saves written by the server ---------------------------------------------
# The server writes ./world_overlay.bin (+ .tmp while writing and .bak, the retained previous save).
/world_overlay.bin
/world_overlay.bin.*
/world/
/saves/
*.mca

# ---- JVM side: downloaded jars, build trees, mappings (never committed or redistributed) ----
# compat/*/build.py download NeoForge / Fabric Loader / Mixin / ASM / the pinned mod into .cache/
# (URL + sha256 pinned in dependencies.json) and compile our own classes into .build/.
*.jar
*.class
/mods/
/compat/fabric-probe/.cache/
/compat/fabric-probe/.build/
/compat/neoforge-events/.cache/
/compat/neoforge-events/.build/
# Mojang/Fabric name mappings and decompiler output are inputs, not sources
*.tiny
/server.txt
mappings*.txt
*.mapping.txt
*.javap.txt
# a vanilla server dropped into the repo root
/server.jar
/libraries/
/versions/
/eula.txt

# ---- game data ----------------------------------------------------------------------------
# This branch keeps its data in-tree (datapacks/vanilla, config_packets.bin, the block/property
# tables and the tests/data fixtures are tracked on purpose: the suite reads them, and the
# fixtures are this project's own measurements). `tools/vanilla_data/gen_vanilla_data.sh` exists
# for regenerating them from your own 1.21.1 jar, but its output is *not* ignored here.
# Only the optional server resource pack is user-supplied.
/resourcepack.zip

# ---- secrets and key material --------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials*.json
.netrc
*.token

# ---- editor, OS and local agent files ------------------------------------------------------
.idea/
.vscode/
*.iml
*.swp
*~
.DS_Store
Thumbs.db
/.codex/
/.agents/
/.claude/
/.cursor/
